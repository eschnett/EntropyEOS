# Object files
*.o
*.obj

# Static/shared libraries
*.a
*.so
*.dylib

# Test and tool binaries (pattern-based so a NEW tool's binary can never be
# swept into a commit before .gitignore learns its name)
tests/test_*
!tests/test_*.cpp
!tests/test_*.hpp
!tests/test_*.cu
tools/*
!tools/*.cpp

# macOS debug-symbol bundles (clang -g)
*.dSYM/

# macOS
.DS_Store
